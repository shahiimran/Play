rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /playlists/{playlistId} {
      allow read: if resource.data.visibility == "public"
        || (request.auth != null && request.auth.uid == resource.data.ownerUid);
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 70
        && request.resource.data.songs is list
        && request.resource.data.songs.size() <= 100
        && request.resource.data.visibility in ["public", "private"];
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.name is string
        && request.resource.data.songs is list
        && request.resource.data.songs.size() <= 100
        && request.resource.data.visibility in ["public", "private"];
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}